# Cloudflare Pages redirects/rewrites for quillstay.com
# Each how-to video has its own link: /how-to-videos/<video-name>
# These rules serve the how-to videos page for those URLs; the page then opens the matching video.
# (No change is needed here when a video is added.)
/how-to-videos/:slug/   /how-to-videos/   200
/how-to-videos/:slug    /how-to-videos/   200
